# Copy to .env, generate a password; never commit .env or .data.
LOCAL_DB_PASSWORD=replace-with-a-random-password
# Optional JSON mapping for request.secret_refs (e.g. db_password).
# LOCAL_SECRETS_FILE=/absolute/path/secrets.json
PORT=9101
LOCAL_DATA_DIR=.data
# Defaults to loopback: this control API can launch Docker workloads.
# Expose the sample app via Tunnel, not this API.

# Optional direct on-premises endpoint (default: tunnel).
# Set the same LOCAL_DELIVERY_MODE and LOCAL_PUBLIC_URL in the engine environment.
# LOCAL_DELIVERY_MODE=direct
# LOCAL_PUBLIC_URL=http://YOUR_SERVER_IP:18080
# Default bind is loopback. Use 0.0.0.0 only with a restricted firewall/security group.
# LOCAL_BIND_ADDRESS=0.0.0.0
# LOCAL_APP_PORT=18080
